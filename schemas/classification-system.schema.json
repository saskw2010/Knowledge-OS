{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-os.dev/schemas/classification-system.schema.json",
  "title": "Knowledge-OS Classification System",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_id", "name", "purpose", "scope", "version", "source", "root_node_ids"],
  "properties": {
    "system_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {
      "type": "object",
      "required": ["en"],
      "properties": {"ar": {"type": ["string", "null"]}, "en": {"type": "string"}},
      "additionalProperties": false
    },
    "purpose": {"type": "string"},
    "scope": {"type": "string"},
    "system_type": {
      "type": "string",
      "enum": ["philosophical", "civilizational", "educational", "research", "library", "bibliometric", "professional", "methodological", "model_reconstructed", "custom"]
    },
    "version": {"type": "string"},
    "issued_at": {"type": ["string", "null"], "format": "date"},
    "maintainer": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "url_or_locator": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "root_node_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["draft", "active", "superseded", "archived"]}
  }
}
