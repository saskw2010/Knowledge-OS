{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-os.dev/schemas/content-index.schema.json",
  "title": "Knowledge-OS Mathematics V0.1 Content Index",
  "description": "An index of versioned knowledge, curriculum, atomic-discipline, and MK7-view artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "index_version", "mathematics_version", "entries", "review_state", "integrity"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "index_id": {"type": "string", "pattern": "^ko\\.content-index\\.[a-z0-9][a-z0-9._-]*$"},
    "index_version": {"const": "0.1"},
    "mathematics_version": {"const": "Mathematics V0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "content_type", "relative_path", "review_state", "mathematics_version", "content_sha256"],
        "properties": {
          "content_id": {"type": "string", "minLength": 1},
          "content_type": {"type": "string", "enum": ["knowledge_node", "atomic_discipline", "curriculum", "mk7_view", "source_snapshot"]},
          "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$"},
          "mathematics_version": {"const": "Mathematics V0.1"},
          "node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "parent_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "atomic_discipline_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_state": {"type": "string", "enum": ["unreviewed", "machine_validated", "human_reviewed", "approved", "rejected"]},
          "content_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "license": {"type": ["string", "null"]}
        }
      }
    },
    "review_state": {
      "type": "string",
      "enum": ["unreviewed", "machine_validated", "human_reviewed", "approved", "rejected"]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "unique_content_ids", "paths_are_relative"],
      "properties": {
        "hash_algorithm": {"const": "sha256"},
        "unique_content_ids": {"const": true},
        "paths_are_relative": {"const": true}
      }
    }
  }
}
