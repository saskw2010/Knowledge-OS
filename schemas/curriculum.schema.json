{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-os.dev/schemas/curriculum.schema.json",
  "title": "Knowledge-OS Mathematics V0.1 Recursive Curriculum",
  "description": "An ordered, review-gated curriculum view over Mathematics V0.1 knowledge nodes and atomic disciplines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_id",
    "curriculum_version",
    "mathematics_version",
    "subject",
    "root_node_ids",
    "atomic_discipline_ids",
    "stages",
    "parent_child_policy",
    "quality_gates",
    "review_state",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "curriculum_id": {"type": "string", "pattern": "^ko\\.curriculum\\.[a-z0-9][a-z0-9._-]*$"},
    "curriculum_version": {"const": "0.1"},
    "mathematics_version": {"const": "Mathematics V0.1"},
    "subject": {"const": "Mathematics"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "root_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ko\\.math\\.v0\\.1\\.[a-z0-9][a-z0-9._-]*$"}
    },
    "atomic_discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ko\\.math\\.v0\\.1\\.ad\\.[a-z0-9][a-z0-9._-]*$"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "sequence", "title", "node_ids", "atomic_discipline_ids", "prerequisite_stage_ids", "review_state"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^ko\\.curriculum\\.[a-z0-9][a-z0-9._-]*\\.stage\\.[a-z0-9][a-z0-9._-]*$"},
          "sequence": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ko\\.math\\.v0\\.1\\.[a-z0-9][a-z0-9._-]*$"}},
          "atomic_discipline_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ko\\.math\\.v0\\.1\\.ad\\.[a-z0-9][a-z0-9._-]*$"}},
          "prerequisite_stage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_state": {"type": "string", "enum": ["unreviewed", "machine_validated", "human_reviewed", "approved", "rejected"]}
        }
      }
    },
    "parent_child_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_mode", "acyclic", "require_symmetric_links", "require_explicit_ids"],
      "properties": {
        "relation_mode": {"const": "broader_to_narrower"},
        "acyclic": {"const": true},
        "require_symmetric_links": {"const": true},
        "require_explicit_ids": {"const": true},
        "max_parent_count": {"type": "integer", "minimum": 1}
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "parent_child_valid", "atomicity_valid", "provenance_complete", "review_complete", "status"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "parent_child_valid": {"type": "boolean"},
        "atomicity_valid": {"type": "boolean"},
        "provenance_complete": {"type": "boolean"},
        "review_complete": {"type": "boolean"},
        "status": {"type": "string", "enum": ["not_ready", "ready_for_review", "approved", "rejected"]},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "review_state": {
      "type": "string",
      "enum": ["unreviewed", "machine_validated", "human_reviewed", "approved", "rejected"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_id"],
        "properties": {
          "source_type": {"type": "string", "enum": ["official_classification", "publication", "model_run", "expert_review", "curriculum", "other"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": ["string", "null"]},
          "version": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]}
        }
      }
    }
  }
}
